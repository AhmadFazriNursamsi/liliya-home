#!/bin/sh
# Rekam stream go2rtc ke file MP4 per segmen (tanpa transcode video).
CAM="$1"
DIR="${CCTV_DIR:-/srv/cctv}/$CAM"
mkdir -p "$DIR"
# Setelah listrik padam STB menyala dengan jam lama (fake-hwclock) sampai tersinkron NTP; nama file
# dan timestamp rekaman memakai jam ini, jadi tunggu sinkron dulu (maks CCTV_CLOCK_WAIT detik,
# setelah itu tetap merekam agar CCTV tidak berhenti saat internet mati).
WAIT="${CCTV_CLOCK_WAIT:-120}"
while [ "$WAIT" -gt 0 ] && [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" != "yes" ]; do
  [ "$WAIT" = "${CCTV_CLOCK_WAIT:-120}" ] && echo "Menunggu jam STB tersinkron sebelum merekam..."
  sleep 2
  WAIT=$((WAIT - 2))
done
# Timestamp memakai jam STB (wallclock): bila kamera putus-sambung, timestamp RTP kamera
# mulai dari nol lagi dan membuat file rusak (durasi salah, player terus loading).
exec ffmpeg -nostdin -hide_banner -loglevel warning \
  -rtsp_transport tcp -timeout 15000000 -use_wallclock_as_timestamps 1 -i "rtsp://127.0.0.1:8554/$CAM" \
  -map 0:v:0 -map 0:a:0? -c:v copy -c:a aac -b:a 32k \
  -f segment -segment_time "${CCTV_SEGMENT:-600}" -segment_atclocktime 1 -reset_timestamps 1 \
  -strftime 1 -segment_format mp4 -segment_format_options movflags=+faststart \
  "$DIR/%Y%m%d_%H%M%S.mp4"
