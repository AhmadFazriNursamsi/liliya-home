CCTV_DIR=/srv/cctv
CCTV_SEGMENT=600
# Rekaman 1080p di SSD (dilihat dari aplikasi BUDI)
CCTV_RETENTION_DAYS=3
CCTV_MIN_FREE_GB=20
# Stream 720p yang di-upload ke Google Drive lalu dihapus dari SSD (tidak pernah dihapus di Drive)
CCTV_UPLOAD_STREAMS=cam1_sd
CCTV_REMOTE=gdrive:CCTV
# Batas kecepatan upload (rclone, byte/detik): 625k = 5 Mbps
CCTV_UPLOAD_BWLIMIT=625k
