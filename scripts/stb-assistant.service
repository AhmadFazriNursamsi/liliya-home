[Unit]
Description=Liliya Home - asisten suara & smart home di STB
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/liliya-home
ExecStart=/opt/liliya-home/venv/bin/python /opt/liliya-home/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
