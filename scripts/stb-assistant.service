[Unit]
Description=STB Gemini Smart Voice Assistant (Alexa Clone)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stb-gemini-assistant
ExecStart=/opt/stb-gemini-assistant/venv/bin/python /opt/stb-gemini-assistant/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
